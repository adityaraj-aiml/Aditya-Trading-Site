# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=techinbyraj

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-immediately

# --- CORS ---
# Comma-separated list of allowed frontend origins, e.g. https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# --- Stripe ---
# From https://dashboard.stripe.com/apikeys (use a test-mode key while developing)
STRIPE_API_KEY=<paste-your-stripe-secret-key-here>
# From the webhook endpoint you create at https://dashboard.stripe.com/webhooks
# pointing at https://<your-backend-domain>/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=<paste-your-stripe-webhook-signing-secret-here>

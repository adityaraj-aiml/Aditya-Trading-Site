# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=techinbyraj

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-immediately

# --- CORS ---
# Comma-separated list of allowed frontend origins, e.g. https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# --- Razorpay ---
# From https://dashboard.razorpay.com/app/keys (use Test Mode keys while developing)
RAZORPAY_KEY_ID=<paste-your-razorpay-key-id-here>
RAZORPAY_KEY_SECRET=<paste-your-razorpay-key-secret-here>
# From the webhook you create at https://dashboard.razorpay.com/app/webhooks
# pointing at https://<your-backend-domain>/api/webhook/razorpay
# (enable at least the "payment.captured" event)
RAZORPAY_WEBHOOK_SECRET=<paste-your-razorpay-webhook-secret-here>
